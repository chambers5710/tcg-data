# Copy to .env in this directory (gitignored). Do not commit secrets.
#
# 1. Dashboard → R2 → Create bucket named tcg-card-images (must match R2_BUCKET).
# 2. R2 → Manage R2 API Tokens → Create token with Object Read & Write on that bucket.
#    That token is S3-style: Access Key ID + Secret Access Key (not a global Cloudflare API token).
# 3. Account ID is on the R2 overview / Workers dashboard right sidebar.

CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET=tcg-card-images
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional. eu or fedramp if the bucket was created with a jurisdiction.
# R2_JURISDICTION=

# Optional. Parallel downloads + uploads. Keep small so images.pokemontcg.io is not hammered.
# CONCURRENCY=4
